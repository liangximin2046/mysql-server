###############################################################################
# ==== Purpose ====
#
# Verify that an Update_rows event whose after-image reuses a unique key value
# that is still held by the before-image of a row coming later in the event
# (unique key rotation, e.g. UPDATE t SET uk = uk + N) is applied on the
# replica in event order, without ER_DUP_ENTRY, when the table has no usable
# PRIMARY KEY / NOT NULL UNIQUE KEY, i.e. when HASH_SCAN would otherwise be
# chosen for the replica-side row lookup.
#
# Background:
#   If a table has no PK and no NOT NULL unique key, but does have a nullable
#   unique key, the replica uses ROW_LOOKUP_HASH_SCAN with that unique key as
#   the driving key. The rows of the event are then applied grouped by
#   ascending key value instead of in event order. When an after-image reuses
#   a unique key value that another row's before-image still holds, the
#   replica hits a duplicate key error that never happened on the source.
#
#   Before this bug is fixed, cases 1-4 below fail at the first
#   sync_to_replica with:
#     1062 Duplicate entry '101-1' for key 't1.c1'
#   and the replica SQL thread stops permanently (repeating on every restart).
#
# ==== Implementation ====
# 1. Original report: nullable UK, rotation by c1 = c1 + 100.
# 2. Rotation applied on the source in descending key order.
# 3. Nullable UK plus a secondary key (HASH_SCAN would drive on the UK).
# 4. Duplicated key values interleaved with a rotated row.
# 5. Functional unique index only and no other usable index.
# 6. Paths that must keep HASH_SCAN: DELETE, and a table without unique keys.
#
# Every case asserts both the row lookup algorithm used on the replica
# (Replica_rows_last_search_algorithm_used) and that the servers converge.
#
# ==== References ====
# Replica stops with ER_DUP_ENTRY when applying an Update_rows event whose
# after-images rotate unique key values (reported in the MySQL bug system).
###############################################################################

--source include/have_binlog_format_row.inc
--source include/have_debug.inc
--source include/rpl/init_source_replica.inc

--echo #
--echo # 1. Original case: nullable UK, key rotation by c1=c1+100
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT DEFAULT NULL, UNIQUE KEY c1 (c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL),(2,2);
INSERT INTO t1 VALUES (1,NULL),(2,NULL);
UPDATE t1 SET c1=c1+100;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL),(2,2);
INSERT INTO t1 VALUES (1,NULL),(2,NULL);
UPDATE t1 SET c1=c1+100;

# The replica stops at the statement above if the bug is present. Report that
# as soon as it happens: sync_to_replica would otherwise block until its
# timeout, since the replica SQL thread can never catch up.
--source include/rpl/connection_replica.inc
--disable_query_log
--let $i= 30
while ($i)
{
  --let $replica_sql_running= query_get_value(SHOW REPLICA STATUS, Replica_SQL_Running, 1)
  if ($replica_sql_running == 'No')
  {
    --let $i= 0
    --let $replica_sql_errno= query_get_value(SHOW REPLICA STATUS, Last_SQL_Errno, 1)
    --let $replica_sql_error= query_get_value(SHOW REPLICA STATUS, Last_SQL_Error, 1)
    --echo # BUG REPRODUCED: replica stopped while applying Update_rows.
    --echo # Last_SQL_Errno= $replica_sql_errno
    --echo # Last_SQL_Error: $replica_sql_error
    --die Replica SQL thread stopped while applying Update_rows (unique key rotation)
  }
  --dec $i
  --sleep 0.5
}
--enable_query_log
--source include/rpl/connection_source.inc

--let $expected_alg= 'INDEX_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--echo #
--echo # 2. Shift with ORDER BY DESC (event order differs from clustered order)
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,1),(3,1);
UPDATE t1 SET c1=c1+1 ORDER BY c1 DESC;
--let $expected_alg= 'INDEX_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--echo #
--echo # 3. Nullable UK plus a secondary key whose order differs from row order
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, c3 INT,
                 UNIQUE KEY uk(c1,c2), KEY k(c3)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (101,1,9),(1,1,0);
UPDATE t1 SET c1=c1+100;
--let $expected_alg= 'INDEX_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--echo #
--echo # 4. Duplicated NULL key values interleaved with a rotated row
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, id INT, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL,1),(1,5,2),(1,NULL,3);
UPDATE t1 SET c2 = CASE id WHEN 1 THEN 7 WHEN 2 THEN 8 WHEN 3 THEN 5 END;
--let $expected_alg= 'INDEX_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--echo #
--echo # 5. Functional UK only, no other index => TABLE_SCAN
--source include/rpl/connection_source.inc
CREATE TABLE t1 (a INT, b INT, UNIQUE INDEX fi ((a+b))) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(0,1);
UPDATE t1 SET a=a+1;
--let $expected_alg= 'TABLE_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--echo #
--echo # 6. Unchanged paths: DELETE and tables without unique keys keep HASH_SCAN
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL);
DELETE FROM t1;
--let $expected_alg= 'HASH_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT, c2 INT, KEY k(c1)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
UPDATE t1 SET c1=c1+1;
--let $expected_alg= 'HASH_SCAN'
--source include/rpl/hash_scan_assertion.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc
DROP TABLE t1;

--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
